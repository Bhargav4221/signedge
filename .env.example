# SignEdge Configuration
# All core capabilities operate offline on-device by default.
# No secret API keys or third-party cloud trackers required.

# Application Environment
VITE_APP_NAME="SignEdge"
VITE_APP_VERSION="1.0.0"
VITE_DEFAULT_LANGUAGE="en-US"
VITE_DEFAULT_SIGN_DIALECT="ASL"

# Offline / Local-first AI Engine Settings
VITE_ENABLE_ON_DEVICE_AI="true"
VITE_OFFLINE_FALLBACK_MODE="enabled"
VITE_SIMULATED_TEST_MODE="false"

# Performance Tiering Configuration (low, medium, high, auto)
VITE_DEFAULT_PERFORMANCE_TIER="auto"

# Privacy Guardrails (Strict local-only enforcement)
VITE_TELEMETRY_ENABLED="false"
VITE_ALLOW_REMOTE_CLOUD_PROCESSING="false"
